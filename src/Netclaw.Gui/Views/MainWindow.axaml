<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Netclaw.Gui.ViewModels"
        xmlns:views="using:Netclaw.Gui.Views"
        x:Class="Netclaw.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Netclaw"
        Width="1100" Height="720">

  <Window.Resources>
    <!-- Shared row template for both session sections. Right-click opens
         the management menu; Pin/Unpin label follows the pin state. -->
    <DataTemplate x:Key="SessionRowTemplate" DataType="vm:SessionListItemViewModel">
      <StackPanel Margin="0,2" Background="Transparent">
        <StackPanel.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Rename"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.BeginRenameCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Pin/Unpin"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.TogglePinCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Archive"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.ArchiveCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Delete..."
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.BeginDeleteCommand}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </StackPanel.ContextMenu>
        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Channel}" Opacity="0.5" FontSize="11" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="240,*" Margin="8">

    <!-- Left: managed session list — pinned on top, context-menu actions,
         confirmation-driven updates (the list refreshes after the daemon
         acks; a rejection shows ActionError and keeps the list). -->
    <DockPanel Grid.Column="0" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="Sessions" FontWeight="Bold" Margin="4,0,0,6" />

      <!-- Rename dialog -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding SessionList.IsRenameOpen}"
              BorderBrush="#888888" BorderThickness="1" CornerRadius="6"
              Padding="8" Margin="0,0,0,6">
        <StackPanel Spacing="6">
          <TextBlock Text="Rename session" FontWeight="Bold" FontSize="12" />
          <TextBox Text="{Binding SessionList.RenameText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SessionList.ConfirmRenameCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Rename" FontSize="12" Command="{Binding SessionList.ConfirmRenameCommand}" />
            <Button Content="Cancel" FontSize="12" Command="{Binding SessionList.CancelRenameCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Delete confirmation: names the session, states permanence, and
           sends nothing until the operator confirms. -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding SessionList.IsDeleteOpen}"
              BorderBrush="#CC3333" BorderThickness="1" CornerRadius="6"
              Padding="8" Margin="0,0,0,6">
        <StackPanel Spacing="6">
          <TextBlock FontSize="12" TextWrapping="Wrap">
            <Run Text="Delete session '" /><Run Text="{Binding SessionList.DeleteTarget.DisplayTitle}" /><Run Text="'?" />
          </TextBlock>
          <TextBlock Text="This deletion is permanent. The history, files, and log of this session are removed."
                     FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Delete" FontSize="12" Foreground="#CC3333"
                    Command="{Binding SessionList.ConfirmDeleteCommand}" />
            <Button Content="Cancel" FontSize="12" Command="{Binding SessionList.CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The daemon's rejection reason for a management action -->
      <TextBlock DockPanel.Dock="Top" Text="{Binding SessionList.ActionError}"
                 FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,6"
                 IsVisible="{Binding SessionList.ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <ScrollViewer>
        <StackPanel>
          <TextBlock Text="Pinned" FontSize="11" Opacity="0.6" Margin="4,0,0,4"
                     IsVisible="{Binding SessionList.HasPinned}" />
          <ListBox ItemsSource="{Binding SessionList.PinnedSessions}"
                   SelectionChanged="OnSessionSelectionChanged"
                   ItemTemplate="{StaticResource SessionRowTemplate}"
                   IsVisible="{Binding SessionList.HasPinned}" Margin="0,0,0,6" />
          <TextBlock Text="All sessions" FontSize="11" Opacity="0.6" Margin="4,0,0,4"
                     IsVisible="{Binding SessionList.HasPinned}" />
          <ListBox ItemsSource="{Binding SessionList.UnpinnedSessions}"
                   SelectionChanged="OnSessionSelectionChanged"
                   ItemTemplate="{StaticResource SessionRowTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Middle: chat -->
    <DockPanel Grid.Column="1">

      <!-- Model dropdown: active model, catalog entries with tool-support
           warnings, loading and failure states. Active marking follows the
           daemon's confirmation, never an optimistic local flip. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
        <DropDownButton Grid.Column="0" FontSize="12" Padding="8,4"
                        Content="{Binding Chat.ModelSelector.ActiveLabel}">
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel MinWidth="260" Spacing="2">
                <TextBlock Text="Loading models..." FontSize="11" Opacity="0.7"
                           IsVisible="{Binding Chat.ModelSelector.IsLoading}" />
                <TextBlock Text="{Binding Chat.ModelSelector.CatalogError}"
                           FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" MaxWidth="320"
                           IsVisible="{Binding Chat.ModelSelector.CatalogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding Chat.ModelSelector.Options}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ModelOptionViewModel">
                      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="8,4" Background="Transparent"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Chat.ModelSelector.SelectCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="&#x25CF;" FontSize="9" VerticalAlignment="Center"
                                     IsVisible="{Binding IsActive}" />
                          <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                          <Border Background="#33CC8833" CornerRadius="8" Padding="6,1"
                                  VerticalAlignment="Center" IsVisible="{Binding HasWarning}">
                            <TextBlock Text="{Binding Warning}" FontSize="10" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Chat.ModelSelector.SelectionError}"
                           FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" MaxWidth="320"
                           IsVisible="{Binding Chat.ModelSelector.SelectionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock Grid.Column="1"
                   Text="{Binding Status}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0" />
      </Grid>

      <!-- Composer -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="4">

        <!-- Grant chips -->
        <ItemsControl ItemsSource="{Binding Chat.GrantedFolders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="x:String">
              <Border Background="#2233AA33" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                  <Button Content="x" FontSize="10" Padding="4,0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveGrantCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pending attachment chips -->
        <ItemsControl ItemsSource="{Binding PendingAttachments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PendingAttachmentChip">
              <Border Background="#223388CC" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                <TextBlock Text="{Binding FileName}" FontSize="11" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="+" Margin="0,0,8,0" VerticalAlignment="Bottom">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Attach file..." Click="OnAttachFileClick" />
                <MenuItem Header="Grant folder access..." Click="OnGrantFolderClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBox Grid.Column="1"
                   Text="{Binding InputText}"
                   PlaceholderText="Message the agent...">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2"
                  Content="Send"
                  Command="{Binding SendCommand}"
                  Margin="8,0,0,0" />
        </Grid>

        <!-- Activity indicator + usage line -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Chat.ActivityText}" Opacity="0.7" FontSize="12" />
            <TextBlock FontSize="12" Opacity="0.7"
                       IsVisible="{Binding HasQueued}">
              <Run Text="Queued: " /><Run Text="{Binding QueuedCount}" />
            </TextBlock>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Chat.UsageText}" Opacity="0.6" FontSize="12" />
        </Grid>
      </StackPanel>

      <!-- History: implicit DataTemplates select the visual per block type -->
      <ScrollViewer x:Name="HistoryScroll">
        <ItemsControl ItemsSource="{Binding Chat.Blocks}">
          <ItemsControl.DataTemplates>

            <DataTemplate DataType="vm:UserMessageBlockViewModel">
              <Border Background="#22000000" CornerRadius="6" Padding="10,6" Margin="40,4,0,4"
                      HorizontalAlignment="Right">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:AssistantMessageBlockViewModel">
              <Border CornerRadius="6" Padding="4" Margin="0,4,40,4">
                <views:MarkdownView Markdown="{Binding Content}" />
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:ThinkingBlockViewModel">
              <Expander Header="Thinking"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        Margin="0,2,40,2">
                <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                     Opacity="0.75" Margin="8,4" />
              </Expander>
            </DataTemplate>

            <DataTemplate DataType="vm:ToolCallBlockViewModel">
              <Expander Header="{Binding Header}"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        Margin="0,2,40,2">
                <StackPanel Margin="8,4" Spacing="6">
                  <TextBlock Text="Arguments" FontWeight="Bold" />
                  <SelectableTextBlock Text="{Binding ArgumentsJson}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono,Consolas,monospace" />
                  <TextBlock Text="Result" FontWeight="Bold" />
                  <SelectableTextBlock Text="{Binding Result}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono,Consolas,monospace" />
                </StackPanel>
              </Expander>
            </DataTemplate>

            <DataTemplate DataType="vm:ApprovalCardViewModel">
              <Border BorderBrush="#CC8800" BorderThickness="1" CornerRadius="6"
                      Padding="10" Margin="0,4,40,4">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding CanRespond}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ApprovalOptionViewModel">
                        <Button Content="{Binding Label}"
                                Margin="0,0,8,0"
                                Command="{Binding $parent[ItemsControl].((vm:ApprovalCardViewModel)DataContext).RespondCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock IsVisible="{Binding IsResolved}" Opacity="0.8">
                    <Run Text="Resolved: " /><Run Text="{Binding ResolvedLabel}" />
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:UsageLineBlockViewModel">
              <TextBlock Text="{Binding Text}" Opacity="0.6" FontSize="11" Margin="0,2" />
            </DataTemplate>

            <DataTemplate DataType="vm:ErrorBlockViewModel">
              <Border BorderBrush="#CC3333" BorderThickness="1" CornerRadius="6"
                      Padding="10,6" Margin="0,4,40,4">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#CC3333" />
              </Border>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>
  </Grid>

</Window>
