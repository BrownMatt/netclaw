<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Netclaw.Gui.ViewModels"
        xmlns:views="using:Netclaw.Gui.Views"
        x:Class="Netclaw.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720">

  <Window.KeyBindings>
    <!-- Window-level so the shortcut works with focus anywhere. -->
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewSessionCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- The active row highlight is driven by IsActive (viewmodel state),
         not by ListBox selection, so it survives a list reload and never
         shows twice across the pinned and unpinned lists. The accent color
         is fixed until Phase 8 makes the shell theme-aware. -->
    <Style Selector="Border.sessionRow">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="6,2,0,2" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Border.sessionRow.active">
      <Setter Property="BorderBrush" Value="#8B5CF6" />
    </Style>
    <Style Selector="Border.sessionRow.active TextBlock.title">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Shared row template for both session sections. Right-click opens
         the management menu; Pin/Unpin label follows the pin state. The
         tooltip carries the absolute times behind the relative texts. -->
    <DataTemplate x:Key="SessionRowTemplate" DataType="vm:SessionListItemViewModel">
      <Border Classes="sessionRow" Classes.active="{Binding IsActive}"
              Background="Transparent" ToolTip.Tip="{Binding TimesTooltip}">
      <StackPanel Background="Transparent">
        <StackPanel.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Rename"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.BeginRenameCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Pin/Unpin"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.TogglePinCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Archive"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.ArchiveCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Delete..."
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SessionList.BeginDeleteCommand}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </StackPanel.ContextMenu>
        <TextBlock Classes="title" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding Channel}" Opacity="0.5" FontSize="11" />
          <TextBlock Text="{Binding LastActivityDisplay}" Opacity="0.5" FontSize="11" />
        </StackPanel>
        <TextBlock Text="{Binding CreatedDisplay}" Opacity="0.5" FontSize="11" />
      </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="240,*,Auto" Margin="8">

    <!-- Left: managed session list — pinned on top, context-menu actions,
         confirmation-driven updates (the list refreshes after the daemon
         acks; a rejection shows ActionError and keeps the list). -->
    <DockPanel Grid.Column="0" Margin="0,0,8,0">
      <!-- Header: title, sort control, new-session button (Ctrl+N). -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,6">
        <TextBlock Grid.Column="0" Text="Sessions" FontWeight="Bold" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" FontSize="11" Padding="6,2" MinHeight="0" Margin="0,0,4,0"
                  ToolTip.Tip="Sort order"
                  ItemsSource="{x:Static vm:SessionListViewModel.SortOptions}"
                  SelectedItem="{Binding SessionList.SelectedSortOption}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:SessionSortOption">
              <TextBlock Text="{Binding Label}" FontSize="11" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="+ New" FontSize="11" Padding="6,2"
                ToolTip.Tip="New session (Ctrl+N)"
                Command="{Binding NewSessionCommand}" />
      </Grid>

      <!-- Rename dialog -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding SessionList.IsRenameOpen}"
              BorderBrush="#888888" BorderThickness="1" CornerRadius="6"
              Padding="8" Margin="0,0,0,6">
        <StackPanel Spacing="6">
          <TextBlock Text="Rename session" FontWeight="Bold" FontSize="12" />
          <TextBox Text="{Binding SessionList.RenameText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SessionList.ConfirmRenameCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Rename" FontSize="12" Command="{Binding SessionList.ConfirmRenameCommand}" />
            <Button Content="Cancel" FontSize="12" Command="{Binding SessionList.CancelRenameCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Delete confirmation: names the session, states permanence, and
           sends nothing until the operator confirms. -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding SessionList.IsDeleteOpen}"
              BorderBrush="#CC3333" BorderThickness="1" CornerRadius="6"
              Padding="8" Margin="0,0,0,6">
        <StackPanel Spacing="6">
          <TextBlock FontSize="12" TextWrapping="Wrap">
            <Run Text="Delete session '" /><Run Text="{Binding SessionList.DeleteTarget.DisplayTitle}" /><Run Text="'?" />
          </TextBlock>
          <TextBlock Text="This deletion is permanent. The history, files, and log of this session are removed."
                     FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Delete" FontSize="12" Foreground="#CC3333"
                    Command="{Binding SessionList.ConfirmDeleteCommand}" />
            <Button Content="Cancel" FontSize="12" Command="{Binding SessionList.CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The daemon's rejection reason for a management action -->
      <TextBlock DockPanel.Dock="Top" Text="{Binding SessionList.ActionError}"
                 FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,6"
                 IsVisible="{Binding SessionList.ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <ScrollViewer>
        <StackPanel>
          <TextBlock Text="Pinned" FontSize="11" Opacity="0.6" Margin="4,0,0,4"
                     IsVisible="{Binding SessionList.HasPinned}" />
          <ListBox ItemsSource="{Binding SessionList.PinnedSessions}"
                   SelectionChanged="OnSessionSelectionChanged"
                   ItemTemplate="{StaticResource SessionRowTemplate}"
                   IsVisible="{Binding SessionList.HasPinned}" Margin="0,0,0,6" />
          <TextBlock Text="All sessions" FontSize="11" Opacity="0.6" Margin="4,0,0,4"
                     IsVisible="{Binding SessionList.HasPinned}" />
          <ListBox ItemsSource="{Binding SessionList.UnpinnedSessions}"
                   SelectionChanged="OnSessionSelectionChanged"
                   ItemTemplate="{StaticResource SessionRowTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Middle: chat -->
    <DockPanel Grid.Column="1">

      <!-- Model dropdown: active model, catalog entries with tool-support
           warnings, loading and failure states. Active marking follows the
           daemon's confirmation, never an optimistic local flip. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
        <DropDownButton Grid.Column="0" FontSize="12" Padding="8,4"
                        Content="{Binding Chat.ModelSelector.ActiveLabel}">
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel MinWidth="260" Spacing="2">
                <TextBlock Text="Loading models..." FontSize="11" Opacity="0.7"
                           IsVisible="{Binding Chat.ModelSelector.IsLoading}" />
                <TextBlock Text="{Binding Chat.ModelSelector.CatalogError}"
                           FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" MaxWidth="320"
                           IsVisible="{Binding Chat.ModelSelector.CatalogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding Chat.ModelSelector.Options}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ModelOptionViewModel">
                      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="8,4" Background="Transparent"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Chat.ModelSelector.SelectCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="&#x25CF;" FontSize="9" VerticalAlignment="Center"
                                     IsVisible="{Binding IsActive}" />
                          <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                          <Border Background="#33CC8833" CornerRadius="8" Padding="6,1"
                                  VerticalAlignment="Center" IsVisible="{Binding HasWarning}">
                            <TextBlock Text="{Binding Warning}" FontSize="10" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Chat.ModelSelector.SelectionError}"
                           FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" MaxWidth="320"
                           IsVisible="{Binding Chat.ModelSelector.SelectionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock Grid.Column="1"
                   Text="{Binding Status}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0" />
      </Grid>

      <!-- Composer -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="4">

        <!-- Grant chips -->
        <ItemsControl ItemsSource="{Binding Chat.GrantedFolders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="x:String">
              <Border Background="#2233AA33" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                  <Button Content="x" FontSize="10" Padding="4,0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveGrantCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pending attachment chips -->
        <ItemsControl ItemsSource="{Binding PendingAttachments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PendingAttachmentChip">
              <Border Background="#223388CC" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                <TextBlock Text="{Binding FileName}" FontSize="11" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="+" Margin="0,0,8,0" VerticalAlignment="Bottom">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Attach file..." Click="OnAttachFileClick" />
                <MenuItem Header="Grant folder access..." Click="OnGrantFolderClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBox Grid.Column="1"
                   Text="{Binding InputText}"
                   PlaceholderText="Message the agent...">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2"
                  Content="Send"
                  Command="{Binding SendCommand}"
                  Margin="8,0,0,0" />
        </Grid>

        <!-- Activity indicator + usage line -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Chat.ActivityText}" Opacity="0.7" FontSize="12" />
            <TextBlock FontSize="12" Opacity="0.7"
                       IsVisible="{Binding HasQueued}">
              <Run Text="Queued: " /><Run Text="{Binding QueuedCount}" />
            </TextBlock>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Chat.UsageText}" Opacity="0.6" FontSize="12" />
        </Grid>
      </StackPanel>

      <!-- History: implicit DataTemplates select the visual per block type.
           The Panel overlays the attach loading state on the history, so a
           slow replay never looks like an empty session. -->
      <Panel>
      <Border IsVisible="{Binding IsLoadingSession}" ZIndex="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="16,10" CornerRadius="6" Background="#22000000">
        <StackPanel Spacing="8" MinWidth="180">
          <TextBlock Text="Loading session..." HorizontalAlignment="Center" Opacity="0.8" />
          <ProgressBar IsIndeterminate="True" />
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="HistoryScroll">
        <ItemsControl ItemsSource="{Binding Chat.Blocks}">
          <ItemsControl.DataTemplates>

            <DataTemplate DataType="vm:UserMessageBlockViewModel">
              <Border Background="#22000000" CornerRadius="6" Padding="10,6" Margin="40,4,0,4"
                      HorizontalAlignment="Right">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:AssistantMessageBlockViewModel">
              <Border CornerRadius="6" Padding="4" Margin="0,4,40,4">
                <views:MarkdownView Markdown="{Binding Content}" />
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:ThinkingBlockViewModel">
              <Expander Header="Thinking"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        Margin="0,2,40,2">
                <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                     Opacity="0.75" Margin="8,4" />
              </Expander>
            </DataTemplate>

            <DataTemplate DataType="vm:ToolCallBlockViewModel">
              <Expander Header="{Binding Header}"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        Margin="0,2,40,2">
                <StackPanel Margin="8,4" Spacing="6">
                  <TextBlock Text="Arguments" FontWeight="Bold" />
                  <SelectableTextBlock Text="{Binding ArgumentsJson}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono,Consolas,monospace" />
                  <TextBlock Text="Result" FontWeight="Bold" />
                  <SelectableTextBlock Text="{Binding Result}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono,Consolas,monospace" />
                </StackPanel>
              </Expander>
            </DataTemplate>

            <DataTemplate DataType="vm:ApprovalCardViewModel">
              <Border BorderBrush="#CC8800" BorderThickness="1" CornerRadius="6"
                      Padding="10" Margin="0,4,40,4">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding CanRespond}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ApprovalOptionViewModel">
                        <Button Content="{Binding Label}"
                                Margin="0,0,8,0"
                                Command="{Binding $parent[ItemsControl].((vm:ApprovalCardViewModel)DataContext).RespondCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock IsVisible="{Binding IsResolved}" Opacity="0.8">
                    <Run Text="Resolved: " /><Run Text="{Binding ResolvedLabel}" />
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:UsageLineBlockViewModel">
              <TextBlock Text="{Binding Text}" Opacity="0.6" FontSize="11" Margin="0,2" />
            </DataTemplate>

            <DataTemplate DataType="vm:ErrorBlockViewModel">
              <Border BorderBrush="#CC3333" BorderThickness="1" CornerRadius="6"
                      Padding="10,6" Margin="0,4,40,4">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#CC3333" />
              </Border>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
      </Panel>

    </DockPanel>

    <!-- Right: diagnostics pane, collapsed by default. One view at a time;
         the view's 5 s timer drives refresh, and a collapsed pane sends no
         requests (the tick guard lives in the viewmodel). -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
      <Button Content="&#x2261;" FontSize="14" Padding="6,10" VerticalAlignment="Top"
              ToolTip.Tip="Diagnostics"
              Command="{Binding Diagnostics.ToggleExpandedCommand}" />
      <Border IsVisible="{Binding Diagnostics.IsExpanded}" Width="360"
              BorderBrush="#444444" BorderThickness="1" CornerRadius="6"
              Padding="8" Margin="6,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
            <Button Content="Logs" FontSize="11" Padding="6,3"
                    Command="{Binding Diagnostics.SelectViewCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsView.Logs}" />
            <Button Content="Models" FontSize="11" Padding="6,3"
                    Command="{Binding Diagnostics.SelectViewCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsView.RunningModels}" />
            <Button Content="Status" FontSize="11" Padding="6,3"
                    Command="{Binding Diagnostics.SelectViewCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsView.Status}" />
            <Button Content="Stats" FontSize="11" Padding="6,3"
                    Command="{Binding Diagnostics.SelectViewCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsView.Stats}" />
            <Button Content="MCP" FontSize="11" Padding="6,3"
                    Command="{Binding Diagnostics.SelectViewCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsView.Mcp}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostics.RefreshIntervalDisplay}"
                     FontSize="10" Opacity="0.5" Margin="0,0,0,6" />

          <!-- One view visible at a time; the Panel is the DockPanel's single
               fill child so every view gets the full remaining height. -->
          <Panel>

          <!-- Logs -->
          <DockPanel IsVisible="{Binding Diagnostics.ShowLogs}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
              <Button Content="Daemon" FontSize="11" Padding="6,2"
                      Command="{Binding Diagnostics.ShowDaemonLogCommand}" />
              <Button Content="Session" FontSize="11" Padding="6,2"
                      IsEnabled="{Binding Diagnostics.SessionLogAvailable}"
                      Command="{Binding Diagnostics.ShowSessionLogCommand}" />
              <TextBlock Text="{Binding Diagnostics.LogFileName}" FontSize="10" Opacity="0.6"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostics.LogError}"
                       FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,4"
                       IsVisible="{Binding Diagnostics.LogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding Diagnostics.LogText}" FontSize="10"
                                   FontFamily="Cascadia Mono,Consolas,monospace" />
            </ScrollViewer>
          </DockPanel>

          <!-- Running models -->
          <DockPanel IsVisible="{Binding Diagnostics.ShowRunningModels}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostics.RunningModelsError}"
                       FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,4"
                       IsVisible="{Binding Diagnostics.RunningModelsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Diagnostics.RunningModels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RunningModelRow">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3">
                      <TextBlock Text="&#x25CF;" FontSize="9" VerticalAlignment="Center"
                                 IsVisible="{Binding IsActive}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Id}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding ProviderKey}" FontSize="10" Opacity="0.6" />
                          <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Opacity="0.6" />
                          <TextBlock Text="{Binding ExpiresDisplay}" FontSize="10" Opacity="0.6" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- Status -->
          <DockPanel IsVisible="{Binding Diagnostics.ShowStatus}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostics.StatusError}"
                       FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,4"
                       IsVisible="{Binding Diagnostics.StatusError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding Diagnostics.StatusText}" FontSize="11"
                                   TextWrapping="Wrap" />
            </ScrollViewer>
          </DockPanel>

          <!-- Stats -->
          <DockPanel IsVisible="{Binding Diagnostics.ShowStats}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostics.StatsError}"
                       FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,4"
                       IsVisible="{Binding Diagnostics.StatsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding Diagnostics.StatsText}" FontSize="11"
                                   TextWrapping="Wrap" />
            </ScrollViewer>
          </DockPanel>

          <!-- MCP -->
          <DockPanel IsVisible="{Binding Diagnostics.ShowMcp}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostics.McpError}"
                       FontSize="11" Foreground="#CC5555" TextWrapping="Wrap" Margin="0,0,0,4"
                       IsVisible="{Binding Diagnostics.McpError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Diagnostics.McpServers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:McpServerRow">
                    <StackPanel Margin="0,3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                        <TextBlock Text="{Binding State}" FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" />
                        <TextBlock FontSize="10" Opacity="0.6" VerticalAlignment="Center">
                          <Run Text="{Binding ToolCount}" /><Run Text=" tools" />
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Text="{Binding Error}" FontSize="10" Foreground="#CC5555"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          </Panel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Grid>

</Window>
