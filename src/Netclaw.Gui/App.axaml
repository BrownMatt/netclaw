<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Netclaw.Gui.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />
    <!-- AvaloniaEdit is a templated control; without its theme styles the
         markdown editor renders as an empty, zero-size control. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>

</Application>
